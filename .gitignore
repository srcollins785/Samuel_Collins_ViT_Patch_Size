# Same policy as Assignment 5: the brief forbids submitting dataset downloads
# or large checkpoints, and a report built from a smoke run reads exactly like
# one built from the real runs. Generated outputs are ignored by default and
# the genuine set is added deliberately with
#   git add -f results/ plots/ report/ (see PLAN.md, section 8)

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.DS_Store

# CIFAR-10 download. The split is rebuilt from data/split_indices.json.
data/cifar-10-batches-py/
data/*.tar.gz
!data/split_indices.json

# Intermediate for the PDF.
report/*.html

results/*.json
results/*.csv
plots/*.png
report/*.md
report/*.pdf

checkpoints/
*.pt
*.pth

# Executed notebook is committed deliberately once src/ is final.
ViT_Patch_Size.ipynb

# Smoke runs (run_experiment.py --smoke) must never be committed.
results/smoke/
plots/smoke/
